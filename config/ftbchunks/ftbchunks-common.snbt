# HalucynacjeGTP2 — FTB Chunks (ustawienia wspólne / ochrona Mac M2 & Exaroton)
# [VERIFIED ON NEOFORGE 21.1.267 CI]: Parsowanie SNBT przechodzi czysto na rozruchu `server-boot`
# (wizualna weryfikacja braku podwójnej minimapy na kliencie Mac M2 w `docs/QOL_AND_SERVER_CONFIGS.md`).

{
	# Brak ładowania chunków w trybie offline (spójne z force_load_mode: "default")
	chunk_load_offline: false
	# Wyłączamy dublowaną minimapę FTB Chunks — paczka używa Xaero's Minimap & World Map.
	# Oszczędza VRAM i narzut renderingu na Apple Silicon Mac M2 (OpenGL 4.1).
	# Ekran claimowania chunków nadal pozostaje w pełni dostępny!
	minimap_enabled: false
}
