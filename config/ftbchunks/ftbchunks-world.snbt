# HalucynacjeGTP2 — FTB Chunks (konfiguracja świata / serwera Exaroton 6-8 GB RAM)
# [VERIFY ON 1.21.1 BOOT]: W NeoForge 1.21.1 FTB Chunks może czytać plik z
# `defaultconfigs/ftbchunks-world.snbt` lub `world/serverconfig/ftbchunks-world.snbt`.
# Po pierwszym uruchomieniu potwierdzić ścieżkę i zsynchronizować w `packwiz`.

{
	# Sojusznicy drużyny FTB Teams mogą współdzielić dostęp do maszyn i skrzyń
	ally_mode: "allies"
	# KRYTYCZNE DLA CREATE 6: zezwala Deployerom, Drillom, Harvesterom i rurkom (Fake Players)
	# na normalną pracę wewnątrz zclaimowanych chunków drużyny!
	allow_fake_players_by_id: true
	claim_dimension_blacklist: [ ]
	claim_dimension_whitelist: [ ]
	disable_protection: false
	fake_players: "allow"
	# "default" = chunki force-loaded działają, gdy przynajmniej 1 gracz drużyny jest online.
	# Chroni CPU/TPS na Exaroton przy pustym serwerze (do zmiany na "always", jeśli drużyna
	# będzie chciała pracę fabryk 24/7).
	force_load_mode: "default"
	hard_team_claim_limit: 0
	hard_team_force_limit: 0
	# 100 chunków wystarcza z zapasem na Wyspę Startową, Wyspę-Rynek, Wyspę Przemysłową,
	# wiadukty kolejowe oraz przyczółki w Netherze/Endzie.
	max_claimed_chunks: 100
	# Limit 20 force-loaded chunks na drużynę (złoty środek 16-25 pod Exaroton 6-8 GB RAM)
	max_force_loaded_chunks: 20
	max_idle_days_before_unclaim: 0.0d
	max_idle_days_before_unforce: 0.0d
	max_prevented_log_age: 7
	no_wilderness: false
	piston_protection: true
	protect_unknown_explosions: true
	require_game_stage: false
}
