// ============================================================================
// HalucynacjeGTP2 — Skyblock Builder: Konfiguracja spawnu (SpawnConfig)
// Platforma: Minecraft 1.21.1 | NeoForge | SkyblockBuilder 21.1.37
// Schemat zweryfikowany ze źródłem: MelanX/SkyblockBuilder (1.21.x) SpawnConfig.java
// ============================================================================
{
  // Wymiar spawnu początkowego (zawsze Overworld).
  spawnDimension: "minecraft:overworld",

  // Promień ochrony spawnu w chunkach (0 = wyłączona; gracze mogą swobodnie budować
  // fabryki na całej Wyspie Startowej w kooperacji znajomych).
  spawnProtectionRadius: 0,

  // Promień szukania bezpiecznego bloku w razie zabudowania dokładnego punktu spawnu.
  radiusToFindValidSpawn: 16,

  // Pierwsza wyspa drużyny generuje się dokładnie w centrum (0, 64, 0).
  skipCenterIslandCreation: false,

  // Wysokość generowania wysp: `set` korzysta z `range.bottom = 64`.
  // W połączeniu z `offset: [-7, -6, -7]` w `templates.json5` powierzchnia wszystkich
  // 3 wysp trafia idealnie na Y = 64, a gracz staje na Y = 65!
  Height: {
    heightCalculationType: "set",
    range: {
      bottom: 64,
      top: 319
    },
    offset: 0
  }
}
