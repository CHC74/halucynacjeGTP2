// ============================================================================
// HalucynacjeGTP2 — Skyblock Builder: Konfiguracja świata (WorldConfig)
// Platforma: Minecraft 1.21.1 | NeoForge | SkyblockBuilder 21.1.37
// Schemat zweryfikowany ze źródłem: MelanX/SkyblockBuilder (1.21.x) WorldConfig.java
//
// UWAGA: Włączanie/wyłączanie pustki (Void) per wymiar konfiguruje się w
// `config/skyblockbuilder/dimensions.json5` (Overworld=custom, Nether/End=normalne).
// ============================================================================
{
  // Biomy w wymiarach custom (ResourceList LibX: allow_list + elements).
  // Dla Overworldu wykluczamy oceany (brak spawnu zwierząt), a właściwy biom wysp
  // (`minecraft:plains` w promieniu 256) ustawiony jest w `dimensions.json5`.
  biomes: {
    "minecraft:overworld": {
      allow_list: false,
      elements: [
        "minecraft:*ocean*"
      ]
    },
    "minecraft:the_nether": {
      allow_list: false,
      elements: []
    }
  },

  // Wyłączamy płaską powierzchnię terenu (zostaje czysty Void Skyblock).
  surface: false,

  // Poziom morza (domyślny waniliowy 63; płyty wysp leżą na Y = 64).
  seaHeight: 63,

  // Odległość między wyspami kolejnych drużyn (w blokach).
  // 8192 gwarantuje zero kolizji między układami 3 wysp (promień ~170 bloków).
  islandDistance: 8192,

  // Zapobiega przedwczesnemu rozlewaniu się cieczy w trakcie generowania struktur.
  preventScheduledTicks: true,

  // Gracz opuszczający drużynę wraca na wyspę spawnu Skyblocka.
  leaveToOverworld: false,

  // Wspólny Overworld Skyblocka (bez eksperymentalnego Infiniverse).
  DimensionPerTeam: {
    enabled: false,
    overworld: true,
    nether: true
  }
}
