// ============================================================================
// HalucynacjeGTP2 — Skyblock Builder: Uprawnienia i teleporty (PermissionsConfig)
// Platforma: Minecraft 1.21.1 | NeoForge | SkyblockBuilder 21.1.37
// Schemat zweryfikowany ze źródłem: MelanX/SkyblockBuilder (1.21.x) PermissionsConfig.java
// ============================================================================
{
  forceSkyblockCheck: false,
  // 2-osobowy co-op gra wspólnie na wyspie Spawn (0, 64, 0), obok której stoją
  // Wyspa-Rynek (152, 64, 0) i Huta (0, 64, 152). Blokujemy tworzenie osobnych drużyn
  // (/skyblock create), żeby żaden gracz nie przeniósł się ~8192 bloki od Rynku (#78).
  // Operatorzy (OP >= minimumPermissionLevelToBypass) zachowują awaryjny dostęp.
  permissions: [
    "teleport_to_spawn",
    "teleport_to_visiting_island",
    "teleport_home",
    "teleport_across_dimensions"
  ],
  minimumPermissionLevelToBypass: 2,
  minimumPermissionLevelToBypassLimitations: 3,
  minimumPermissionLevelToExecuteCommands: 4,

  Teleports: {
    // Bezpieczne teleporty bez obrażeń od upadku (przyjazny co-op na Skyblocku).
    negateFallDamage: true,
    disallowTeleportationDuringFalling: false,
    teleportationDimensions: {
      allow_list: false,
      elements: []
    },
    Cooldowns: {
      // Skrócone cooldowny dla kooperacji znajomych: 200 ticków = 10 sekund (domyślnie 3 min).
      spawnCooldown: 200,
      visitCooldown: 200,
      homeCooldown: 200
    }
  },

  Spawns: {
    range: 50
  }
}
