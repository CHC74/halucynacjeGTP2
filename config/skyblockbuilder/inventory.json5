// ============================================================================
// HalucynacjeGTP2 — Skyblock Builder: Ustawienia ekwipunku (InventoryConfig)
// Platforma: Minecraft 1.21.1 | NeoForge | SkyblockBuilder 21.1.37
// Schemat zweryfikowany ze źródłem: MelanX/SkyblockBuilder (1.21.x) InventoryConfig.java
//
// UWAGA: Lista samych przedmiotów startowych znajduje się w osobnym pliku:
// `config/skyblockbuilder/starter_inventory.json5` (SkyPaths.ITEMS_FILE).
// ============================================================================
{
  // Nie czyścimy ekwipunku na starcie (zachowujemy kompatybilność z księgami modów).
  clearInitialInventory: false,

  // Nie wyrzucamy przedmiotów przy opuszczaniu drużyny (spójne z `keepInventory = true`).
  dropItems: false,

  // Gracz dostaje pakiet startowy z `starter_inventory.json5` przy pierwszym wejściu na świat.
  // Dozwolone wartości: "spawn", "team".
  initialInventoryType: "spawn"
}
