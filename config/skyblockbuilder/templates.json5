// ============================================================================
// HalucynacjeGTP2 — Skyblock Builder: Konfiguracja szablonów i wysp (TemplatesConfig)
// Platforma: Minecraft 1.21.1 | NeoForge | SkyblockBuilder 21.1.37
// Schemat zweryfikowany ze źródłem: MelanX/SkyblockBuilder (1.21.x)
//   - TemplatesConfig.java, TemplateInfoMapper.java, TemplateSpawns.java,
//     TemplateSpreads.java, SingleSpreadEntry.java, SkyPaths.java
//
// Ścieżki plików `.nbt` (zgodne ze SkyPaths.java):
//   - Wyspa główna (ISLANDS_DIR): config/skyblockbuilder/templates/islands/starter_island.nbt
//   - Wyspy towarzyszące (SPREADS_DIR):
//       * config/skyblockbuilder/templates/spreads/market_island.nbt
//       * config/skyblockbuilder/templates/spreads/industrial_island.nbt
//
// Wyrównanie współrzędnych (Height.range.bottom = 64, SpreadInfo$Origin.CENTER = size // 2):
//   - starter_island.nbt (15x13x15, offset [-7, -6, -7]):
//       narożnik (-7, 58, -7) -> środek powierzchni (7, 6, 7) = świat (0, 64, 0)
//       punkt spawnu (7, 7, 7) = świat (0, 65, 0), patrzenie: EAST (+X na Rynek!)
//   - market_island.nbt (45x25x35, floor_y=8, size//2=(22,12,17), offset [152, 4, 0], origin "center"):
//       środek powierzchni (22, 8, 17) -> 64 + 4 - 12 + 8 = świat (152, 64, 0) — idealny poziom Y=64!
//   - industrial_island.nbt (33x21x33, floor_y=6, size//2=(16,10,16), offset [0, 4, 152], origin "center"):
//       środek powierzchni (16, 6, 16) -> 64 + 4 - 10 + 6 = świat (0, 64, 152) — idealny poziom Y=64!
// ============================================================================
{
  // Dodatkowe globalne przesunięcie wysp (0 = pierwsza drużyna na osi 0, 0).
  defaultOffset: 0,

  // Referencje punktów spawnu dla szablonów (klucze kierunków: south, west, north, east).
  spawnPointReferences: {
    starter_center: {
      south: [],
      west: [],
      north: [],
      // Gracz spawnuje się dokładnie na (7, 7, 7) [świat: (0, 65, 0)] na bloku trawy (7, 6, 7)
      // i od pierwszej sekundy patrzy na Wschód (wprost na Pirs i Wyspę-Rynek +152E!).
      east: [
        [7, 7, 7]
      ]
    }
  },

  // Referencje wysp towarzyszących (spreads) wczytywanych z `templates/spreads/`.
  spreadReferences: {
    tycoon_triad: [
      {
        file: "market_island.nbt",
        offset: [152, 4, 0],
        origin: "center"
      },
      {
        file: "industrial_island.nbt",
        offset: [0, 4, 152],
        origin: "center"
      }
    ]
  },

  // Lista dostępnych szablonów wysp (pierwszy wpis jest domyślny dla świata).
  templateList: [
    {
      name: "Halucynacje Tycoon (3 Wyspy)",
      desc: "Wyspa Startowa (0,64,0) + Wyspa-Rynek (+152E) + Huta Południowa (+152S). Pure-Create Skyblock.",
      file: "starter_island.nbt",
      spawns: "starter_center",
      offset: [-7, -6, -7],
      spreads: "tycoon_triad",
      allowPaletteSelection: false
    }
  ],

  // Brak sztucznych wysp wokół portalu w Netherze — Nether generuje się w 100% normalnie.
  netherSpreads: []
}
